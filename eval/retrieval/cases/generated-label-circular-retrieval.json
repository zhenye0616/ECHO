{
  "id": "generated-label-circular-retrieval",
  "priority": "P1",
  "intent": "Generated Ask-ECHO/cluster labels are noise when the intent is the underlying primary work.",
  "repo_path": "$EVAL_REPO",
  "time_window": {
    "since": "2026-05-29T00:00:00.000Z",
    "until": "2026-05-30T00:00:00.000Z"
  },
  "reference_now": "2026-05-30T00:00:00.000Z",
  "fixture_files": ["eval/retrieval/fixtures/core.jsonl"],
  "query_variants": [
    {
      "id": "generated-label",
      "query": "discussion about ECHO",
      "baseline_status": "expected_fail_current_behavior",
      "expected_failure": {
        "reason": "Literal search can retrieve a generated label that merely points at itself instead of the underlying work.",
        "followup_candidate": "label-aware-noise-penalty",
        "allowed_failed_metrics": [
          "primary_recall",
          "top_rank_success",
          "weighted_precision_at_5",
          "weighted_precision_overall",
          "signal_noise_ratio_at_10",
          "forbidden_noise"
        ],
        "allowed_missing_refs": ["label-primary-work"],
        "allowed_forbidden_noise_refs": ["label-noise-generated"],
        "allowed_warning_gaps": []
      }
    },
    {
      "id": "underlying-work-control",
      "query": "pending decisions projection",
      "baseline_status": "pass"
    }
  ],
  "tool_recipe": [
    {
      "step_id": "discovery",
      "tool": "search_memories",
      "kind": "discovery",
      "primary_discovery": true,
      "params": {
        "query": "$query",
        "since": "$case.time_window.since",
        "until": "$case.time_window.until",
        "repo_path": "$case.repo_path",
        "limit": 10
      }
    },
    {
      "step_id": "hydrate",
      "tool": "get_atoms",
      "kind": "hydration",
      "params": {
        "atom_ids": "$steps.discovery.matches[*].id",
        "prefer": "as_requested"
      },
      "ids_limit": 10,
      "deterministic_order": "discovery_order"
    }
  ],
  "required_sources": ["codex"],
  "required_primary": ["label-primary-work"],
  "required_context": [],
  "acceptable_context": [],
  "noise": [],
  "forbidden_noise": ["label-noise-generated"],
  "must_warn": [],
  "canonical_answer_facts": [
    "The generated label is not primary evidence.",
    "The underlying decision-card/pending-decisions work is the primary evidence."
  ],
  "budgets": {
    "per_call_bytes": 25000,
    "total_bytes": 50000,
    "max_calls": 3
  },
  "provenance": [
    {
      "kind": "note",
      "ref": "backlog/ready/2026-05-29-082-retrieval-quality-eval-harness.md#AC5"
    }
  ]
}
