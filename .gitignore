# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Obsidian (if used for wiki) — per-user UI state, plugins, themes
.obsidian/

# Forensic / dogfooding dump artifacts — kept on disk for analysis but regeneratable
# from source; don't commit (large JSON dumps that bloat history without adding value).
raw/internal/dogfooding/**/full-response.json
raw/internal/**/*.html
!raw/internal/dogfooding/journal-style.html

# Claude Code agent runtime logs
.claude/logs/

# Sensitive interview data (uncomment if needed)
# raw/internal/interviews/

# Per-user Claude Code settings — never check in
.claude/settings.local.json

# Claude Code scheduler/loop runtime lock — transient process state
.claude/scheduled_tasks.lock

# Claude Code subagent worktrees — harness state, not project content
.claude/worktrees/

# Superpowers brainstorming companion — local mockups + browser state
.superpowers/

# Node / TypeScript
node_modules/
dist/
coverage/
*.log

# Python (tools/blocked.py et al)
__pycache__/
*.pyc

# Raycast extension generated declarations (regenerated by ray build / ray develop)
tools/raycast-echo/raycast-env.d.ts
