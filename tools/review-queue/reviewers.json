{
  "$schema": "./schemas/reviewers-config.schema.json",
  "reviewers": [
    {
      "name": "codex",
      "mode": "headless",
      "required": true,
      "timeout_hours": null,
      "slash_command": "review-queue-codex",
      "invoke_command": "codex exec -C {{WT}} --sandbox danger-full-access - < {{PROMPT}}"
    },
    {
      "name": "cursor",
      "mode": "ide",
      "required": true,
      "timeout_hours": 2,
      "slash_command": "review-queue-cursor"
    },
    {
      "name": "codex-ops",
      "mode": "headless",
      "required": true,
      "timeout_hours": null,
      "slash_command": "review-queue-codex-ops",
      "invoke_command": "codex exec -C {{WT}} --sandbox danger-full-access - < {{PROMPT}}"
    },
    {
      "name": "claude",
      "mode": "headless",
      "required": false,
      "timeout_hours": null,
      "slash_command": "review-queue-claude",
      "invoke_command": "claude --model fable --dangerously-skip-permissions -p < {{PROMPT}}"
    }
  ]
}
