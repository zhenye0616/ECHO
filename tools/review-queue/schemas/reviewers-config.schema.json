{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://echo.local/review-queue/reviewers-config.schema.json",
  "title": "review-queue reviewers.json config",
  "description": "Schema for tools/review-queue/reviewers.json — the per-deploy reviewer roster + runtime metadata. Source of truth for the reviewer slugs known to combine.py / request.py / shared helpers. The reviewer.schema.json + request.schema.json `reviewer` enums must be kept in sync manually when a reviewer is added (per spec 043 R1 HIGH #5).",
  "type": "object",
  "required": ["reviewers"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mode", "required", "timeout_hours", "slash_command"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "mode": {
            "type": "string",
            "enum": ["headless", "ide"]
          },
          "required": {
            "type": "boolean"
          },
          "timeout_hours": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "slash_command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
