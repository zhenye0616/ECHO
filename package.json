{
  "name": "echo-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "echoctl": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build:cli": "tsc -p tsconfig.cli.json",
    "daemon": "vite-node src/daemon/index.ts",
    "daemon:install": "scripts/launchd/install.sh",
    "daemon:uninstall": "scripts/launchd/uninstall.sh",
    "daemon:status": "launchctl print gui/$(id -u)/com.echo.daemon | grep -E '^\\s*(state|pid|last exit code|program)' || echo 'not loaded'",
    "daemon:logs": "tail -f $HOME/Library/Logs/echo/daemon.err.log $HOME/Library/Logs/echo/daemon.out.log",
    "watch:stream": "vite-node tools/stream-watch.ts",
    "render:trace": "vite-node tools/render-trace.ts",
    "serve:trace": "vite-node tools/serve-trace.ts",
    "validate:resolution": "vite-node tools/validate-resolution.ts",
    "lint": "eslint . --max-warnings 0 && npm run lint:task-state",
    "lint:task-state": "python3 tools/task-state/lint.py",
    "format": "prettier --write src tests package.json tsconfig.json vitest.config.ts eslint.config.js .prettierrc.json",
    "format:check": "prettier --check src tests package.json tsconfig.json vitest.config.ts eslint.config.js .prettierrc.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "smol-toml": "^1.6.1"
  }
}
