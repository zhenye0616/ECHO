{
  "name": "echoctl",
  "version": "0.1.0-beta.1",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "echoctl": "./dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.sql",
    "!dist/surfaces/ceo-slack-responder/**",
    "dist/surfaces/ceo-slack-responder/propose-decision-tool.js",
    "dist/surfaces/ceo-slack-responder/responder.js",
    "dist/surfaces/ceo-slack-responder/brain.js",
    "dist/surfaces/ceo-slack-responder/intake-seed.js",
    "dist/surfaces/ceo-slack-responder/intake-agent.js",
    "dist/surfaces/ceo-slack-responder/intake-draft-store.js",
    "dist/surfaces/ceo-slack-responder/decision-changeset.js",
    "dist/surfaces/ceo-slack-responder/draft-store.js",
    "dist/surfaces/ceo-slack-responder/decision-store.js",
    "dist/surfaces/ceo-slack-responder/identity.js",
    "dist/surfaces/ceo-slack-responder/issue-render.js",
    "dist/surfaces/ceo-slack-responder/linear-client.js",
    "assets/echo-skills/**",
    "assets/echo-roles/**",
    "assets/echo-workflows/**",
    "tools/review-queue/coord-roles.json",
    "tools/review-queue/reviewer-bindings.json",
    "tools/review-queue/reviewers.json",
    "tools/review-queue/schemas/**",
    "docs/echoctl-install.md",
    "docs/install-contracts.md",
    "docs/lab-data-handling.md",
    "./CHANGELOG.md",
    "./LICENSE",
    "./package.json",
    "./README.md"
  ],
  "scripts": {
    "test": "npm run test:repo && npm run test:product && npm run test:orchestration",
    "test:product": "vitest run --config vitest.product.config.ts",
    "test:repo": "vitest run --config vitest.repo.config.ts",
    "test:orchestration": "vitest run --config vitest.orchestration.config.ts",
    "product:check-boundary": "node tools/product/check-boundary.mjs",
    "product:prepare-offline-deps": "node tools/product/prepare-offline-deps.mjs",
    "product:build-artifact": "node tools/product/build-artifact.mjs",
    "product:validate-qualification": "node tools/product/validate-qualification.mjs",
    "build:cli": "tsc -p tsconfig.cli.json && node scripts/copy-sql-migrations.js",
    "prepack": "npm run build:cli",
    "daemon": "vite-node src/daemon/index.ts",
    "daemon:install": "scripts/launchd/install.sh",
    "daemon:uninstall": "scripts/launchd/uninstall.sh",
    "daemon:status": "launchctl print gui/$(id -u)/com.echo.daemon | grep -E '^\\s*(state|pid|last exit code|program)' || echo 'not loaded'",
    "daemon:logs": "tail -f $HOME/Library/Logs/echo/daemon.err.log $HOME/Library/Logs/echo/daemon.out.log",
    "watch:stream": "vite-node tools/stream-watch.ts",
    "intake:terminal": "vite-node --script tools/intake-terminal.ts",
    "trace:card": "vite-node --script tools/trace-card.ts",
    "render:trace": "vite-node tools/render-trace.ts",
    "serve:trace": "vite-node tools/serve-trace.ts",
    "validate:resolution": "vite-node --script tools/validate-resolution.ts",
    "eval:retrieval": "vite-node --script tools/retrieval-eval/run.ts",
    "lint": "eslint . --max-warnings 0 && npm run lint:task-state",
    "lint:task-state": "python3 tools/task-state/lint.py",
    "format": "prettier --write src tests package.json tsconfig.json vitest*.config.ts eslint.config.js .prettierrc.json",
    "format:check": "prettier --check src tests package.json tsconfig.json vitest*.config.ts eslint.config.js .prettierrc.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "cross-spawn": "7.0.6",
    "smol-toml": "^1.6.1",
    "zod": "^4.4.3"
  }
}
